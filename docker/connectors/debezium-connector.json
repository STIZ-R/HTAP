{
  "name": "debezium-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "htap-postgres",
    "database.port": "5432",
    "database.user": "htap",
    "database.password": "htap",
    "database.dbname": "htapdb",
    "database.server.name": "htap",
    "slot.name": "dbz_slot",
    "plugin.name": "pgoutput",
    "publication.autocreate.mode": "filtered",
    "table.include.list": "public.*",
    "tombstones.on.delete": "false",
    "topic.prefix": "htap",
    "poll.interval.ms": "50",
    "max.queue.size": "4096",
    "max.batch.size": "1024"
  }
}
