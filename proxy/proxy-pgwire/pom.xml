<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================= -->
    <!-- Parent : proxy (root)     -->
    <!-- ========================= -->
    <parent>
        <groupId>com.htap.meta</groupId>
        <artifactId>proxy</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- ========================= -->
    <!-- Module                    -->
    <!-- ========================= -->
    <artifactId>proxy-pgwire</artifactId>
    <packaging>jar</packaging>
    <name>proxy-pgwire</name>
    <description>PostgreSQL wire protocol (pgwire) server for HTAP proxy</description>

    <!-- ========================= -->
    <!-- Dependencies              -->
    <!-- ========================= -->
    <dependencies>

        <!-- Spring Boot (lifecycle, config, DI) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Netty : TCP + pgwire -->
        <!-- Source: https://mvnrepository.com/artifact/io.netty/netty-all -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.2.9.Final</version>
            <scope>compile</scope>
        </dependency>

        <!-- Internal modules -->
        <dependency>
            <groupId>com.htap.meta</groupId>
            <artifactId>proxy-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.htap.meta</groupId>
            <artifactId>executors</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.htap.meta</groupId>
            <artifactId>utils</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- SQL parsing (si utilisé par QueryAnalyzer / router) -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.5</version>
        </dependency>


    </dependencies>

    <!-- ========================= -->
    <!-- Build                     -->
    <!-- ========================= -->
    <build>
        <plugins>

            <!-- Spring Boot executable jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>com.htap.meta.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
