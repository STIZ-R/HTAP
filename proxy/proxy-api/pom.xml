<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.htap.meta</groupId>
        <artifactId>proxy</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>proxy-api</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Spring Boot Web pour exposer les endpoints REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Tes modules internes -->
        <dependency>
            <groupId>com.htap.meta</groupId>
            <artifactId>utils</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.htap.meta</groupId>
            <artifactId>proxy-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.htap.meta</groupId>
            <artifactId>executors</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Si QueryAnalyzer utilise JSqlParser -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>4.5</version>
        </dependency>

        <!-- Driver JDBC PostgreSQL / ClickHouse si besoin ici -->
        <!-- à garder là ou dans executors/proxy-core selon ton choix -->
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin Spring Boot pour construire un jar exécutable -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.htap.meta.Main</mainClass>
                </configuration>
            </plugin>

            <!-- Compiler, si tu veux le laisser ici -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
